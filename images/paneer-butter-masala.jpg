<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 260" width="100%" height="100%">
  <defs>
    <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFECB3" />
      <stop offset="100%" stop-color="#FFB74D" />
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="6" stdDeviation="8" flood-color="#3A2312" flood-opacity="0.15"/>
    </filter>
  </defs>
  <rect width="400" height="260" fill="url(#grad)" />
  <circle cx="200" cy="115" r="75" fill="#FFFFFF" opacity="0.9" filter="url(#shadow)"/>
  <circle cx="200" cy="115" r="66" fill="none" stroke="#E65100" stroke-width="2.5" stroke-dasharray="4 3" opacity="0.6"/>
  <text x="200" y="132" font-size="64" text-anchor="middle" dominant-baseline="middle">🍛</text>
  <rect x="50" y="205" width="300" height="34" rx="17" fill="#FFFFFF" opacity="0.95" filter="url(#shadow)" />
  <text x="200" y="222" font-family="'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="14" font-weight="bold" fill="#3A2312" text-anchor="middle" dominant-baseline="middle">Paneer Butter Masala</text>
  <circle cx="28" cy="28" r="8" fill="#E65100" opacity="0.3"/>
  <circle cx="372" cy="40" r="14" fill="#E65100" opacity="0.25"/>
  <circle cx="360" cy="190" r="6" fill="#E65100" opacity="0.3"/>
</svg>