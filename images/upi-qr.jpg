<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 380" width="100%" height="100%">
  <defs>
    <linearGradient id="qrBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF" />
      <stop offset="100%" stop-color="#FFF8F0" />
    </linearGradient>
    <filter id="qrShadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#3A2312" flood-opacity="0.12"/>
    </filter>
  </defs>

  <!-- Card Background -->
  <rect width="320" height="380" rx="16" fill="url(#qrBg)" stroke="#E5D7CA" stroke-width="2"/>

  <!-- Header Banner -->
  <rect x="0" y="0" width="320" height="52" rx="16" fill="#3A2312"/>
  <rect x="0" y="36" width="320" height="16" fill="#3A2312"/>
  <text x="160" y="32" font-family="'Segoe UI', Roboto, sans-serif" font-size="14" font-weight="bold" fill="#FFFFFF" text-anchor="middle">CAMPUS CAFÉ UPI PAYMENT</text>

  <!-- QR Frame -->
  <g transform="translate(45, 75)" filter="url(#qrShadow)">
    <rect width="230" height="230" rx="12" fill="#FFFFFF" stroke="#E65100" stroke-width="2.5"/>
    
    <!-- QR Corner Boxes Top-Left -->
    <rect x="20" y="20" width="46" height="46" rx="6" fill="#3A2312"/>
    <rect x="28" y="28" width="30" height="30" rx="4" fill="#FFFFFF"/>
    <rect x="35" y="35" width="16" height="16" rx="2" fill="#E65100"/>

    <!-- QR Corner Boxes Top-Right -->
    <rect x="164" y="20" width="46" height="46" rx="6" fill="#3A2312"/>
    <rect x="172" y="28" width="30" height="30" rx="4" fill="#FFFFFF"/>
    <rect x="179" y="35" width="16" height="16" rx="2" fill="#E65100"/>

    <!-- QR Corner Boxes Bottom-Left -->
    <rect x="20" y="164" width="46" height="46" rx="6" fill="#3A2312"/>
    <rect x="28" y="172" width="30" height="30" rx="4" fill="#FFFFFF"/>
    <rect x="35" y="179" width="16" height="16" rx="2" fill="#E65100"/>

    <!-- Decorative QR Data Matrix Blocks -->
    <rect x="80" y="25" width="14" height="24" fill="#3A2312"/>
    <rect x="105" y="25" width="22" height="14" fill="#3A2312"/>
    <rect x="140" y="25" width="14" height="14" fill="#3A2312"/>
    <rect x="80" y="60" width="24" height="14" fill="#3A2312"/>
    <rect x="115" y="55" width="14" height="24" fill="#3A2312"/>
    <rect x="140" y="50" width="14" height="14" fill="#3A2312"/>

    <rect x="25" y="80" width="14" height="24" fill="#3A2312"/>
    <rect x="50" y="90" width="16" height="14" fill="#3A2312"/>
    <rect x="25" y="115" width="24" height="14" fill="#3A2312"/>
    <rect x="55" y="120" width="14" height="24" fill="#3A2312"/>

    <rect x="165" y="80" width="24" height="14" fill="#3A2312"/>
    <rect x="195" y="90" width="15" height="25" fill="#3A2312"/>
    <rect x="165" y="110" width="15" height="15" fill="#3A2312"/>
    <rect x="175" y="135" width="30" height="14" fill="#3A2312"/>

    <!-- Center UPI Badge -->
    <circle cx="115" cy="115" r="24" fill="#E65100"/>
    <circle cx="115" cy="115" r="20" fill="#FFFFFF"/>
    <text x="115" y="120" font-family="'Segoe UI', sans-serif" font-size="12" font-weight="900" fill="#E65100" text-anchor="middle">UPI</text>

    <!-- Bottom Matrix Blocks -->
    <rect x="80" y="165" width="20" height="14" fill="#3A2312"/>
    <rect x="110" y="165" width="15" height="24" fill="#3A2312"/>
    <rect x="135" y="165" width="25" height="14" fill="#3A2312"/>
    <rect x="80" y="190" width="15" height="20" fill="#3A2312"/>
    <rect x="105" y="200" width="30" height="10" fill="#3A2312"/>
    <rect x="145" y="190" width="20" height="20" fill="#3A2312"/>
    <rect x="175" y="170" width="15" height="15" fill="#3A2312"/>
    <rect x="195" y="190" width="15" height="20" fill="#3A2312"/>
  </g>

  <!-- Footer instruction -->
  <text x="160" y="332" font-family="'Segoe UI', Roboto, sans-serif" font-size="12" font-weight="bold" fill="#3A2312" text-anchor="middle">Scan with any UPI App</text>
  <text x="160" y="352" font-family="'Segoe UI', Roboto, sans-serif" font-size="10.5" fill="#7A573F" text-anchor="middle">GPay • PhonePe • Paytm • BHIM</text>
</svg>
